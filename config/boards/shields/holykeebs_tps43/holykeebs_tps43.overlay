#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <dt-bindings/i2c/i2c.h>

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix_transform = &tps43_transform;
		zmk,input = &tps43_listener;
	};

	tps43_listener: tps43_listener {
		compatible = "zmk,input-listener";
		device = <&tps43>;
	};

	tps43_transform: keymap_transform {
		compatible = "zmk,matrix-transform";
		columns = <1>;
		rows = <1>;
		map = <RC(0, 0)>;
	};

	kscan0: kscan0 {
		compatible = "zmk,kscan-mock";
		rows = <1>;
		columns = <1>;
		events = <ZMK_MOCK_PRESS(0, 0, 100)>;
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			bindings = <
				&kp ESC
			>;
		};
	};
};

&pro_micro_i2c {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	tps43: iqs5xx@74 {
		status = "okay";
		compatible = "azoteq,iqs5xx";
		reg = <0x74>;

		reset-gpios = <&pro_micro 14 GPIO_ACTIVE_LOW>;
		rdy-gpios = <&pro_micro 15 GPIO_ACTIVE_HIGH>;

		one-finger-tap;
		two-finger-tap;
		press-and-hold;
		scroll;
		natural-scroll-y;
	};
};
